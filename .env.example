# =============================================================================
# slm_learning — environment variables
# =============================================================================
# Copy to .env.local for development. Server-side keys only — no Vite/renderer
# in this project, so no VITE_ prefix needed.
#
# Categories:
#   [REQUIRED]  — gateway smoke + Stage-1 teacher distillation won't run without
#   [INFERENCE] — model serving (Modal vLLM endpoint when deployed)
#   [TRAINING]  — HuggingFace model downloads + datasets
#   [GATEWAY]   — fallback API gateway when local SLM not ready
# =============================================================================


# =============================================================================
# Anthropic API key — Stage-1 distillation teacher
# =============================================================================
# Used by scripts/distillation/teacher_anthropic.py to generate (prompt, gad-cli)
# pairs for SLM distillation. Also the fallback for `gad ask --backend frontier`
# when Modal vLLM endpoint is down.
#
# Get yours: https://console.anthropic.com/settings/keys
# [REQUIRED]
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-replace-me


# =============================================================================
# OpenRouter — multi-provider gateway fallback
# =============================================================================
# Free-tier models for low-priority distillation runs and bulk eval. Used by
# scripts/gateway/openrouter_client.py.
#
# Get yours: https://openrouter.ai/keys
# [GATEWAY]
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-replace-me


# =============================================================================
# HuggingFace — model + dataset downloads
# =============================================================================
# Used by `gad hf download` (wraps huggingface_hub.snapshot_download) and
# scripts/data/load_external_datasets.py. Required for gated models like
# NousResearch/Hermes-4-14B (apache-2.0, but token still authorizes the
# download endpoint).
#
# Get yours: https://huggingface.co/settings/tokens
# [TRAINING]
# =============================================================================
HF_TOKEN=hf_replace-me


# =============================================================================
# Modal — Hermes-4-14B vLLM deploy + GPU training
# =============================================================================
# Set both via `modal token new` (writes to ~/.modal.toml) OR paste here.
# Used by modal_app/hermes_4_14b_serve.py (deploy) and Stage-3 DPO training
# scripts that call Modal Functions.
#
# Get from Modal dashboard: https://modal.com/settings/tokens
# [INFERENCE] [TRAINING]
# =============================================================================
MODAL_TOKEN_ID=ak-replace-me
MODAL_TOKEN_SECRET=as-replace-me


# =============================================================================
# Modal vLLM endpoint URL — populated AFTER deploy
# =============================================================================
# After `modal deploy modal_app/hermes_4_14b_serve.py`, Modal returns a URL
# like https://<workspace>--hermes-4-14b-serve.modal.run. Paste it here so
# `gad ask --backend modal` and the Kael chat SLM-mode can reach it.
#
# Default: empty (SLM disabled, falls back to Anthropic frontier path).
# [INFERENCE]
# =============================================================================
MODAL_VLLM_URL=
