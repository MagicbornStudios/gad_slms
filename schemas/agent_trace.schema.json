{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slm-learning/schemas/agent_trace.schema.json",
  "title": "Agent Trace",
  "description": "Full multi-step trajectory record for a single agent session working toward one goal. Each step is one atomic action (tool call, edit, decision, message). The trace is the richest training signal in the tower: it captures planning, error recovery, correction, and attribution in sequence. Source: .planning/.gad-log/ envelopes with role=tool_call/response stitched by session_id.",
  "type": "object",
  "required": [
    "trace_id",
    "projectid",
    "agent_id",
    "runtime",
    "ts_start",
    "goal",
    "steps",
    "final_outcome"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Unique trace ID. Format: 'trace-<runtime_short>-<session_short>-<seq>'. Example: 'trace-cc-a3f-001'."
    },
    "projectid": {
      "type": "string",
      "description": "gad project scope."
    },
    "agent_id": {
      "type": "string",
      "description": "Agent or worker ID. 'claude-code-main' for interactive sessions."
    },
    "runtime": {
      "type": "string",
      "enum": ["claude-code", "codex-cli", "gemini-cli", "opencode", "human"]
    },
    "session_id": {
      "type": ["string", "null"],
      "default": null
    },
    "ts_start": {
      "type": "string",
      "format": "date-time"
    },
    "ts_end": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "goal": {
      "type": "string",
      "description": "The stated objective at trace start. Maps to gad task goal field where linked."
    },
    "task_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "gad task registry ID if this trace maps to a registered task. Example: 'GLOBAL-T-173-20'."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered sequence of agent actions.",
      "items": {
        "type": "object",
        "required": ["step_index", "action_type", "tool", "inputs", "output_summary", "success"],
        "properties": {
          "step_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-indexed step number."
          },
          "action_type": {
            "type": "string",
            "enum": [
              "tool_call",
              "message",
              "decision",
              "edit",
              "read",
              "bash",
              "handoff",
              "stamp"
            ],
            "description": "Category of action taken."
          },
          "tool": {
            "type": "string",
            "description": "Tool name or action verb. Examples: 'Bash', 'Edit', 'Read', 'gad-tasks-stamp', 'message'."
          },
          "inputs": {
            "type": "object",
            "description": "Key inputs to the action. Keep to salient fields only — do not embed full file contents.",
            "additionalProperties": true
          },
          "output_summary": {
            "type": "string",
            "description": "Short summary of what the action returned or produced."
          },
          "output_truncated": {
            "type": "boolean",
            "default": false,
            "description": "True if the full output was truncated for storage."
          },
          "duration_ms": {
            "type": ["integer", "null"],
            "minimum": 0,
            "default": null
          },
          "success": {
            "type": "boolean",
            "description": "True if the step completed without error or correction."
          },
          "error_class": {
            "type": ["string", "null"],
            "default": null,
            "description": "Error category if success=false. Examples: 'tool_not_found', 'permission_denied', 'schema_invalid', 'fabricated_attribution'."
          },
          "tokens_in": {
            "type": ["integer", "null"],
            "minimum": 0,
            "default": null
          },
          "tokens_out": {
            "type": ["integer", "null"],
            "minimum": 0,
            "default": null
          }
        },
        "additionalProperties": false
      }
    },
    "final_outcome": {
      "type": "string",
      "enum": ["success", "failure", "partial"],
      "description": "Aggregate outcome for the full trace."
    },
    "artifacts_produced": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Relative paths to files created or modified during this trace."
    },
    "human_intervened": {
      "type": "boolean",
      "default": false,
      "description": "True if the operator provided a correction mid-trace."
    },
    "correction_applied": {
      "type": ["string", "null"],
      "default": null,
      "description": "Description of the correction if human_intervened=true."
    },
    "quality_label": {
      "type": ["string", "null"],
      "default": null,
      "description": "Curation label: 'approved', 'rejected', 'MANUAL_REVIEW_REQUIRED'."
    }
  },
  "examples": [
    {
      "trace_id": "trace-cc-a3f-001",
      "projectid": "global",
      "agent_id": "claude-code-main",
      "runtime": "claude-code",
      "session_id": "ses-2026-05-09-001",
      "ts_start": "2026-05-09T14:00:00Z",
      "ts_end": "2026-05-09T14:08:30Z",
      "goal": "Wire InlineByokRequest component into Kael chat stream",
      "task_id": "GLOBAL-T-173-20",
      "steps": [
        {
          "step_index": 0,
          "action_type": "read",
          "tool": "Read",
          "inputs": { "file_path": "apps/desktop/src/components/kael/KaelFocusMode.tsx" },
          "output_summary": "Read 320 lines of KaelFocusMode component",
          "output_truncated": false,
          "duration_ms": 210,
          "success": true,
          "tokens_in": null,
          "tokens_out": null
        },
        {
          "step_index": 1,
          "action_type": "edit",
          "tool": "Edit",
          "inputs": {
            "file_path": "apps/desktop/src/components/kael/KaelFocusMode.tsx",
            "summary": "Insert InlineByokRequest render inside message stream"
          },
          "output_summary": "Edit applied successfully",
          "output_truncated": false,
          "duration_ms": 380,
          "success": true
        }
      ],
      "final_outcome": "success",
      "artifacts_produced": ["apps/desktop/src/components/kael/KaelFocusMode.tsx"],
      "human_intervened": false,
      "correction_applied": null,
      "quality_label": "approved"
    }
  ],
  "additionalProperties": false
}
