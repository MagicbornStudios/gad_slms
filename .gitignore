.venv/
.venv-cuda/
.venv-gpu/
.claude/
.gad/logs/
__pycache__/
*.py[cod]

data/external/
data/reasoning_pairs.json
data/distilled_pairs.jsonl
# Combined / derived training corpora — regeneratable from sources.
data/multitask_combined.jsonl
data/*_combined.jsonl
/runs/
/models/

# Track experiment manifests + logs + eval JSON, but not bulky weight files
experiments/runs/*/checkpoint.pt
experiments/runs/*/checkpoint*.pt
experiments/runs/*/**/*.safetensors
experiments/runs/*/**/*.bin
experiments/runs/*/checkpoint-*/

# Hidden ad-hoc training-run logs (.sweep-*, .multitask-*, .hf-job-*, etc).
# These are ephemeral console captures from background runs; the canonical
# record lives in experiments/runs/<name>/manifest.json + eval/ outputs.
experiments/runs/.*.log
experiments/runs/.*
# Track the adapter/ directory's MANIFEST + config + README, but not the
# tokenizer copies (they're identical to the base model's tokenizer).
experiments/runs/*/adapter/tokenizer.json
experiments/runs/*/adapter/tokenizer_config.json
experiments/runs/*/adapter/special_tokens_map.json
experiments/runs/*/adapter/chat_template.jinja

node_modules/
.env
.env.*
.planning/graph.html
.planning/graph.json
.planning/.trace-events.jsonl
.planning/.trace-seq
.planning/.gad-log/

# gad CLI runtime artifact mirrors — regenerated by `gad update`,
# not source. Keep .agent/ and .cursor/ tracked (they predate this rule).
.augment/
.codex/
.gemini/
.opencode/
.windsurf/
.github/

# Team dispatcher runtime state (logs, PIDs, per-worker queues).
# Track team/config.json + team/profiles/ as content.
.planning/team/dispatcher.log.jsonl
.planning/team/supervisor.log.jsonl
.planning/team/dispatcher.pid
.planning/team/dispatch.seq
.planning/team/workers/

.DS_Store
Thumbs.db
data/openmathinstruct_5k.jsonl
